<Window x:Class="CodescoveryCaptureManager.App.Windows.CapturedWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Captured Window" Height="458" Width="800" MinWidth="420" MinHeight="260"
        Loaded="CapturedWindows_OnLoaded" Closing="CapturedWindows_OnClosing"
        MouseLeftButtonDown="CapturedWindows_OnMouseLeftButtonDown"
        MouseDoubleClick="CapturedWindows_OnMouseDoubleClick"
        WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" WindowState="Normal"
        Foreground="White" TextElement.FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="5" CaptionHeight="0" ResizeBorderThickness="4" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3A3A3" />
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <DockPanel Background="#1E1E1E">
        <Border Name="CapturedWindowsMenu" DockPanel.Dock="Top" Height="48" Background="#262626"
                MouseLeftButtonDown="CapturedWindowsMenu_OnMouseLeftButtonDown">
            <DockPanel Margin="10,0,6,0">
                <Image DockPanel.Dock="Left" Source="../Assets/icon.png" Width="28" Height="28" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Click="OpenCapturePicker"
                            ToolTip="Choose windows to share">
                        <materialDesign:PackIcon Kind="MonitorShare" Width="20" Height="20" />
                    </Button>
                    <Button Name="SettingsButton" Style="{StaticResource ToolbarButton}" ToolTip="Settings"
                            Click="SettingsButton_OnClick">
                        <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" />
                        <Button.ContextMenu>
                            <ContextMenu Name="SettingsMenu" Opened="SettingsMenu_OnSubmenuOpened">
                                <MenuItem Header="When no selected window is focused" Name="FallbackMenu">
                                    <MenuItem Header="Show a message" Name="FallbackMessage" IsCheckable="True"
                                              IsChecked="True" Click="FallbackMessage_OnClick" />
                                    <MenuItem Header="Keep the last window" Name="FallbackKeepLast" IsCheckable="True"
                                              Click="FallbackKeepLast_OnClick" />
                                    <Separator Name="FallbackWindowsSeparator" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Virtual desktop" Name="VirtualDesktopActions" IsEnabled="False">
                                    <MenuItem Header="Move to virtual desktop" Name="MoveToVirtualDesktop"
                                              Click="MoveToVirtualDesktop_OnClick" IsEnabled="False" />
                                    <MenuItem Header="Close virtual desktop" Name="CloseVirtualDesktop"
                                              Click="CloseVirtualDesktop_OnClick" IsEnabled="False" />
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Name="MenuExpanderButton" Style="{StaticResource ToolbarButton}"
                            ToolTip="Hide toolbar" PreviewMouseLeftButtonDown="MenuExpander_OnClick">
                        <materialDesign:PackIcon Name="MenuExpander" Kind="ArrowUp" Width="18" Height="18" />
                    </Button>
                    <Button Name="WindowMinimizeButton" Style="{StaticResource ToolbarButton}"
                            Click="WindowMinimizeButton_OnClick" ToolTip="Minimize">
                        <materialDesign:PackIcon Kind="Minimize" Width="18" Height="18" />
                    </Button>
                    <Button Name="WindowMaximizeButton" Style="{StaticResource ToolbarButton}"
                            Click="MaximizeButton_OnClick" ToolTip="Maximize">
                        <materialDesign:PackIcon Kind="Maximize" Width="18" Height="18" />
                    </Button>
                    <Button Name="WindowCloseButton" Style="{StaticResource ToolbarButton}"
                            Click="WindowCloseButton_OnClick" ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </StackPanel>
                <TextBox Name="CurrentWindowTitle" VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left"
                         materialDesign:HintAssist.Hint="Window title shown to viewers"
                         ToolTip="Title of this window in the Teams / Meet / OBS share picker" />
            </DockPanel>
        </Border>

        <Button Name="ShowToolbarButton" DockPanel.Dock="Top" Visibility="Collapsed" HorizontalAlignment="Right"
                Style="{StaticResource ToolbarButton}" Margin="0,4,6,0" Background="#262626"
                ToolTip="Show toolbar" PreviewMouseLeftButtonDown="MenuExpander_OnClick">
            <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18" />
        </Button>

        <Grid Name="ScreenCaptureGrid">
            <StackPanel Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <materialDesign:PackIcon Kind="MonitorShare" Width="56" Height="56" Foreground="{StaticResource BrandBrush}"
                                         HorizontalAlignment="Center" />
                <TextBlock Text="No windows selected" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"
                           HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Text="Pick the windows to expose. This window then shows only the one you are focused on; share it in Teams, Meet or OBS instead of your screen." />
                <Button Content="Choose windows" Margin="0,16,0,0" HorizontalAlignment="Center"
                        Style="{StaticResource MaterialDesignRaisedButton}" Click="OpenCapturePicker" />
            </StackPanel>

            <StackPanel Name="NoFocusState" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center" MaxWidth="420">
                <materialDesign:PackIcon Kind="EyeOff" Width="56" Height="56" Foreground="{StaticResource BrandBrush}"
                                         HorizontalAlignment="Center" />
                <TextBlock Text="No selected window is focused" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Text="Nothing is being shared right now. Click one of the windows you picked and it appears here." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
