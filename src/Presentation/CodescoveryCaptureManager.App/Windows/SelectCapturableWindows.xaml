<Window x:Class="CodescoveryCaptureManager.App.Windows.SelectCapturableWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Choose windows to share"
        Width="960" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="White"
        TextElement.FontSize="13"
        KeyDown="Window_OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#333333" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BrandColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A3A3A3" />
        <SolidColorBrush x:Key="ThumbnailBackdropBrush" Color="#141414" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <DataTemplate x:Key="WindowCardTemplate">
            <Border Name="Card" Width="224" Margin="8" Padding="0,0,0,10"
                    CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                    Background="{StaticResource CardBrush}" Cursor="Hand"
                    ToolTip="{Binding Title}"
                    MouseLeftButtonUp="Card_OnMouseLeftButtonUp">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="120" CornerRadius="6,6,0,0" ClipToBounds="True"
                            Background="{StaticResource ThumbnailBackdropBrush}">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="WindowRestore" Width="32" Height="32"
                                                         HorizontalAlignment="Center" Foreground="#555555" />
                                <TextBlock Text="Minimized - restore it to preview" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                           Visibility="{Binding IsMinimized, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>

                            <Border Width="24" Height="24" CornerRadius="12" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{StaticResource AccentBrush}"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}">
                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{StaticResource BrandForegroundBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="10,8,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0"
                               Source="{Binding Icon}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProcessName}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Choose windows to share" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Only the selected windows appear in the capture window. Share that one window in Teams, Meet or OBS." />
            </StackPanel>
            <TextBox Grid.Column="1" Name="SearchBox" Margin="16,0,0,0" VerticalAlignment="Center"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Search by title or app"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     TextChanged="SearchBox_OnTextChanged" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="WindowCards" ItemTemplate="{StaticResource WindowCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15"
                       Text="No windows found." />
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Select all" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="SelectAll_OnClick" />
                <Button Content="Clear" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="Clear_OnClick" />
                <Button Content="Save as profile..." Style="{StaticResource MaterialDesignFlatButton}"
                        Click="SaveAsProfile_OnClick"
                        ToolTip="Save the selected windows as a reusable profile" />
            </StackPanel>
            <TextBlock Grid.Column="1" Name="SelectionSummary" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="Cancel_OnClick" />
                <Button Content="Apply" Name="ApplyButton" IsDefault="False"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Apply_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
