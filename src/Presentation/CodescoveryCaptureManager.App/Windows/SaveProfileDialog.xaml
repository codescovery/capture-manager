<Window x:Class="CodescoveryCaptureManager.App.Windows.SaveProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:CodescoveryCaptureManager.App.Windows"
        Title="Save profile" Width="760" Height="520" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="White" TextElement.FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3A3A3" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFB74D" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Save profile" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,2,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="A profile stores rules, not windows: apps get new handles when restarted. Each rule matches a process and part of the title (for example the solution name in Visual Studio)." />
            <TextBox Name="ProfileName" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Profile name" MaxLength="80" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,16,0,6" Text="Rules" FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="RuleList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:RuleRow}">
                        <Border Margin="0,0,0,8" Padding="10" CornerRadius="6" Background="#2A2A2A">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ProcessName}" />
                                    <TextBlock Text="process" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                          ItemsSource="{x:Static local:RuleRow.Modes}"
                                          SelectedItem="{Binding TitleMatch}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBox Text="{Binding TitlePattern, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Title text"
                                             IsEnabled="{Binding TitleApplies}" />
                                    <TextBlock Text="Matches every window of this app" FontSize="11"
                                               Foreground="{StaticResource WarningBrush}"
                                               Visibility="{Binding MatchesEveryWindow, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="3" Margin="12,0,0,0" Content="Auto-attach" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoAttach}"
                                          IsEnabled="{Binding TitleApplies}"
                                          ToolTip="Attach windows that match this rule when they open later" />
                                <Button Grid.Column="4" Margin="8,0,0,0" Width="32" Height="32" Padding="0"
                                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="Remove rule"
                                        Tag="{Binding}" Click="RemoveRule_OnClick">
                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="ErrorText" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Save" IsDefault="True" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Save_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
