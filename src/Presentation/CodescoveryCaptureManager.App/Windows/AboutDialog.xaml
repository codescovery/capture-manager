<Window x:Class="CodescoveryCaptureManager.App.Windows.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="About Capture Manager" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="White" TextElement.FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3A3A3" />
    </Window.Resources>
    <StackPanel Margin="28,24,28,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/icon.png" Width="56" Height="56" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Capture Manager" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Name="VersionText" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Text="Pick the windows you want to expose and share this one window instead of your screen. Only the focused picked window is ever shown, so nothing else leaks." />

        <UniformGrid Columns="2" Margin="0,20,0,0">
            <Button Margin="0,0,6,8" Click="Repository_OnClick" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Github" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="GitHub" />
                </StackPanel>
            </Button>
            <Button Margin="6,0,0,8" Click="ReportIssue_OnClick" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BugOutline" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Report an issue" />
                </StackPanel>
            </Button>
            <Button Margin="0,0,6,0" Click="Releases_OnClick" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Tag" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Releases" />
                </StackPanel>
            </Button>
            <Button Margin="6,0,0,0" Click="CopyInfo_OnClick" Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Name="CopyInfoText" Text="Copy version info" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <Grid Margin="0,20,0,0">
            <TextBlock Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                <Run Text="© Codescovery · " />
                <Hyperlink Click="License_OnClick" Foreground="{DynamicResource PrimaryHueMidBrush}">MIT License</Hyperlink>
            </TextBlock>
            <Button HorizontalAlignment="Right" Content="Close" IsDefault="True" IsCancel="True" Click="Close_OnClick" />
        </Grid>
    </StackPanel>
</Window>
