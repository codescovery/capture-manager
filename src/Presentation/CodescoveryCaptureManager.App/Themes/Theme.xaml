<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One palette, one type scale, one set of buttons for every window of the app. -->
    <Color x:Key="BrandColor">#8DC63F</Color>
    <Color x:Key="BrandHoverColor">#9FD455</Color>
    <Color x:Key="BrandPressedColor">#7AB232</Color>
    <Color x:Key="BrandForegroundColor">#10140A</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandPressedBrush" Color="{StaticResource BrandPressedColor}" />
    <SolidColorBrush x:Key="BrandForegroundBrush" Color="{StaticResource BrandForegroundColor}" />

    <SolidColorBrush x:Key="WindowBrush" Color="#161616" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CardBrush" Color="#262626" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#383838" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="FaintBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2B84B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

    <!-- MaterialDesign controls (text boxes, check boxes, menus) follow the brand colour. -->
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="{StaticResource BrandForegroundColor}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="{StaticResource BrandForegroundColor}" />

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
        <Border Name="Surface" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Tag carries the corner radius so the caption buttons can stay square. -->
    <Style x:Key="AppButtonBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}" />
        <Setter Property="Tag">
            <Setter.Value>
                <CornerRadius>6</CornerRadius>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BrandForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Small text-like button for the status bar. -->
    <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Tag">
            <Setter.Value>
                <CornerRadius>4</CornerRadius>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimize / maximize / close, Windows 11 proportions. -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Tag">
            <Setter.Value>
                <CornerRadius>0</CornerRadius>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Grouping surface used by dialogs and the settings window. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
</ResourceDictionary>
