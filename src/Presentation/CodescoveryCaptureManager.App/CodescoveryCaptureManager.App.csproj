<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
	  <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
	  <SignAssembly>false</SignAssembly>
	  <Authors>Vinicius Andrade</Authors>
	  <Company>Codescovery</Company>
	  <Product>CodescoveryCaptureManager</Product>
	  <PackageId>CodescoveryCaptureManager</PackageId>
	  <PackageIcon>icon32.png</PackageIcon>
	  <RepositoryUrl>https://github.com/codescovery/captureManager</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <Copyright>Codescovery</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <Description>Multiple window capture application, that will display the focused windows only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\icon.ico" />
    <None Remove="Assets\icon.png" />
    <None Remove="Assets\icon.svg" />
    <None Remove="Assets\menu.png" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="..\..\Domain\CodescoveryCaptureManager.Domain\CodescoveryCaptureManager.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <WebProjectDir>$(MSBuildThisFileDirectory)..\..\Web\CodescoveryCaptureManager.Web\</WebProjectDir>
    <WebDistDir>$(WebProjectDir)dist\</WebDistDir>
  </PropertyGroup>

  <!-- React UI served by the focus bridge. Pass -p:SkipWebBuild=true to build the desktop app without Node. -->
  <Target Name="BuildWebUi" BeforeTargets="AssignTargetPaths" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebProjectDir)" Condition="!Exists('$(WebProjectDir)node_modules')" ContinueOnError="true" />
    <Exec Command="npm run build" WorkingDirectory="$(WebProjectDir)" ContinueOnError="true" />
    <ItemGroup>
      <WebUiFile Include="$(WebDistDir)**\*" />
      <Content Include="@(WebUiFile)" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Warning Condition="'@(WebUiFile)' == ''" Text="Web UI not built (is Node installed?). The desktop app works, but http://127.0.0.1:47800/ will not serve a page." />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\icon.svg" />
  </ItemGroup>

</Project>
