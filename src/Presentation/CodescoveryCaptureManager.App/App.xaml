<Application x:Class="CodescoveryCaptureManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CodescoveryCaptureManager.App"
             Startup="App_OnStartup"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Brand green from Assets/icon.svg replaces the theme's primary hue. -->
            <Color x:Key="BrandColor">#8DC63F</Color>
            <Color x:Key="BrandForegroundColor">#1E1E1E</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
            <SolidColorBrush x:Key="BrandForegroundBrush" Color="{StaticResource BrandForegroundColor}" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource BrandColor}" />
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="{StaticResource BrandForegroundColor}" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="{StaticResource BrandColor}" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="{StaticResource BrandForegroundColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
